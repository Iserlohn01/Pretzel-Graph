{
    "name": "pretzel-graph",
    "version": "0.0.738",
    "private": true,
    "license": "Elastic-2.0",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "postinstall": "patch-package",
        "dev": "concurrently \"npm run dev -w packages/backend\" \"npm run dev -w packages/worker\" \"npm run dev -w packages/frontend\" \"npm run watch:indexes -w packages/nodes\" --names \"BACKEND,WORKER,WEB,INDEX\" --prefix-colors \"magenta,green,cyan,blue\"",
        "build:images": "bash scripts/build-images.sh",
        "build:image": "bash scripts/build-images.sh",
        "build": "npm run build --workspaces --if-present"
    },
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@types/node": "^25.2.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "patch-package": "^8.0.1",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@langchain/anthropic": "1.3.22",
        "@langchain/core": "^1.1.31",
        "@langchain/google-genai": "2.1.24",
        "@langchain/openai": "1.2.12",
        "@langchain/openrouter": "^0.1.10"
    }
}
